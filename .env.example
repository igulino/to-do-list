NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Ajuste os dados do PostgreSQL antes de executar as migrations.
DB_URL=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=tdl
DB_SCHEMA=public

# Alternativamente, DATABASE_URL tem prioridade sobre os campos DB_*.
# DATABASE_URL=postgresql://postgres:senha@localhost:5432/tdl?schema=public

# Reservado para a implementação da autenticação. Use um segredo aleatório.
JWT_SECRET=
JWT_EXPIRES_IN=1h
