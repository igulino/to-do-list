NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Banco local criado no passo 3 do README. Troque a senha fora do ambiente local.
DB_URL=localhost
DB_PORT=5432
DB_USER=tdl_app
DB_PASSWORD=tdl_local_password
DB_NAME=tdl
DB_SCHEMA=public

# Alternativamente, DATABASE_URL tem prioridade sobre os campos DB_*.
# DATABASE_URL=postgresql://tdl_app:tdl_local_password@localhost:5432/tdl?schema=public

# Obrigatório para login. Gere um segredo aleatório conforme o passo 2 do README.
JWT_SECRET=
JWT_EXPIRES_IN=1h
